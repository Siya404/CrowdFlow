# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Secret used to sign login sessions (use a long random string)
AUTH_SECRET=change-me

# Secret used to sign attendee QR codes (must match the dataset's QR secret)
QR_SECRET=dev-secret-change-me

# Only if your app uses a database
DATABASE_URL=file:./dev.db

# Public values (safe to expose to the browser)
NEXT_PUBLIC_APP_NAME=CrowdFlow
NEXT_PUBLIC_SIMULATION_MODE=true
